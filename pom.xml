<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.onesley</groupId>
    <artifactId>oneclick-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>oneclick-parent</name>
    <description>OneClick — Parent POM aggregating microservices (Phase 2 §21 spec senior dev)</description>

    <!-- ════════════════════════════════════════════════════════════════════
         Maven multi-module aggregator
         ════════════════════════════════════════════════════════════════════
         oneclick-shared  : DTOs partagés (events, PageResponse) — bootless, no DB
         oneclick-core    : monolithe résiduel (13 modules sur 14 originaux)
         (à venir)
         oneclick-notification-service  port 8084
         oneclick-loyalty-service       port 8085
         oneclick-payment-service       port 8086
         oneclick-search-service        port 8087
         oneclick-gateway               port 8080  (Spring Cloud Gateway)
         ════════════════════════════════════════════════════════════════════ -->
    <modules>
        <module>oneclick-shared</module>
        <module>oneclick-core</module>
        <module>oneclick-notification-service</module>
        <module>oneclick-loyalty-service</module>
        <module>oneclick-payment-service</module>
        <module>oneclick-search-service</module>
        <module>oneclick-gateway</module>
    </modules>

    <properties>
        <java.version>26</java.version>
        <sentry.version>8.27.0</sentry.version>
        <spring-restdocs.version>4.0.0</spring-restdocs.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>2.8.6</springdoc.version>
        <spring-modulith.version>2.0.6</spring-modulith.version>
    </properties>

    <!-- ════════════════════════════════════════════════════════════════════
         DependencyManagement — versions partagées par tous les modules
         ════════════════════════════════════════════════════════════════════ -->
    <dependencyManagement>
        <dependencies>
            <!-- Modules internes : version cohérente partout -->
            <dependency>
                <groupId>com.onesley</groupId>
                <artifactId>oneclick-shared</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- BOMs externes -->
            <dependency>
                <groupId>io.sentry</groupId>
                <artifactId>sentry-bom</artifactId>
                <version>${sentry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MapStruct fixe au niveau parent (utilisé par plusieurs modules) -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- springdoc fixe au niveau parent -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
