# ════════════════════════════════════════════════════════════════════
# OneClick Backend — Template environnement
# ════════════════════════════════════════════════════════════════════
# Copier en `.env` (gitignored) et remplir avec les vraies valeurs.
# Le `run.sh` peut sourcer ce fichier automatiquement (à venir Phase 11+).
#
# Pour l'instant, tu peux soit :
#   1. Source manuellement : `source .env && ./run.sh --oauth2`
#   2. Utiliser direnv : créer un `.envrc` qui contient `source_env .env`
#   3. Préfixer la commande : `APP_SECURITY_JWT_SECRET="..." ./run.sh --oauth2`
#
# ⚠️ JAMAIS commit le .env final. Si un secret leak : rotater immédiatement.
# ════════════════════════════════════════════════════════════════════

# ─── Spring Security (Phase 5.1 / 6.2) ────────────────────────────────
# Active la validation JWT (sinon mode dev permitAll)
APP_SECURITY_OAUTH2_ENABLED=true
# JWT Secret HS256 — DOIT être 256 bits minimum
# Générer : openssl rand -base64 64
# ⚠️ JAMAIS commit. Si exposé : rotater immédiatement.
APP_SECURITY_JWT_SECRET=your-jwt-secret-here-replace-with-openssl-rand-base64-64

# Pour le profile "secure" (alias) :
JWT_SECRET=your-jwt-secret-here-replace-with-openssl-rand-base64-64

# ─── DB Production (application-prod.yml) ─────────────────────────────
# Le profil prod boot fail si DB_PASSWORD non défini (pas de default).
DB_URL=jdbc:postgresql://localhost:5432/oneclick
DB_USERNAME=oneclick_app
DB_PASSWORD=CHANGEME-strong-prod-password

# ─── DB Dev (application-dev.yml) — DB legacy oneclick_local ───────────
# Defaults : oneclick_app / OneclickLocal2026 (compose.yaml local)
DEV_DB_URL=jdbc:postgresql://localhost:5432/oneclick_local
DEV_DB_USERNAME=oneclick_app
DEV_DB_PASSWORD=OneclickLocal2026

# ─── DB Enterprise (application-enterprise.yml) — DB greenfield ───────
ENTERPRISE_DB_URL=jdbc:postgresql://localhost:5432/oneclick_enterprise
ENTERPRISE_DB_USERNAME=oneclick_app
ENTERPRISE_DB_PASSWORD=OneclickLocal2026

# ─── ETL profile (application-etl.yml) — Phase 13 data migration ──────
# Tourne en mode CLI sous l'user superuser local (hh).
ETL_DB_USERNAME=hh
ETL_DB_PASSWORD=oneclick_dev_pwd
# Source legacy (postgres_fdw)
ETL_LEGACY_HOST=localhost
ETL_LEGACY_PORT=5432
ETL_LEGACY_DB=oneclick_local
ETL_LEGACY_USER=oneclick_app
ETL_LEGACY_PASSWORD=OneclickLocal2026
# Password fallback pour users sans hash auth.users
ETL_FALLBACK_PASSWORD=TestLocal2026!

# ─── Flyway (DDL migrations — needs the table owner) ─────────────────
# Flyway runs ALTER TABLE statements (V3, V4) which require the owner role,
# not the application role. We use `hh` as owner.
#
# - Docker setup : password = oneclick_dev_pwd (cf compose.yaml POSTGRES_PASSWORD)
# - Brew setup   : leave password empty (peer auth via Unix socket)
FLYWAY_USER=hh
FLYWAY_PASSWORD=oneclick_dev_pwd
# Pour le profile enterprise :
ENTERPRISE_FLYWAY_USER=hh
ENTERPRISE_FLYWAY_PASSWORD=oneclick_dev_pwd

# ─── Redis (application-prod.yml) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ─── Elasticsearch (modules/analytics) ────────────────────────────────
# Local dev : pas d'auth. Prod : TLS + API key (cf feedback_e1_google_places_pending.md)
ES_URL=http://localhost:9200
# ES_API_KEY=your-api-key-here  # prod uniquement

# ─── MinIO / S3 (core/media) ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true
S3_BUCKET=oneclick-media
S3_PUBLIC_BASE_URL=http://localhost:9000

# ─── OCR.space (modules/loyalty — port snap2earn/ocr-receipt) ─────────
# Si non défini : service tombe en mode stub (log + résultat vide).
# Free tier : https://ocr.space/ocrapi
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/imageurl
OCR_SPACE_LANGUAGE=fre

# ─── FCM Push notifications (core/notification — port send-*-push) ────
# Si non défini : service tombe en mode stub.
# Récupérer depuis Firebase Console → Project Settings → Service Accounts.
FCM_PROJECT_ID=
# Chemin OU contenu JSON inline (Spring résout les deux)
FCM_SERVICE_ACCOUNT_JSON=

# ─── Sentry (Phase 11+) ──────────────────────────────────────────────
# SENTRY_DSN=https://xxx@o123.ingest.de.sentry.io/456

# ─── Cron secret (jobs @Scheduled internes) ──────────────────────────
# CRON_SECRET=$(openssl rand -hex 32)
