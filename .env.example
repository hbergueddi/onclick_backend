# Template — copier en `.env` (gitignored) et remplir avec les vraies valeurs.
# Le `run.sh` peut sourcer ce fichier automatiquement (à venir Phase 11+).
#
# Pour l'instant, tu peux soit :
#   1. Source manuellement : `source .env && ./run.sh --oauth2`
#   2. Utiliser direnv : créer un `.envrc` qui contient `source_env .env`
#   3. Préfixer la commande : `APP_SECURITY_JWT_SECRET="..." ./run.sh --oauth2`

# ─── Spring Security (Phase 5.1) ─────────────────────────────────────
# Active la validation JWT (sinon mode dev permitAll)
APP_SECURITY_OAUTH2_ENABLED=true
# JWT Secret Supabase — Dashboard → Settings → API → JWT Settings → JWT Secret
# ⚠️ JAMAIS commit. Si exposé : rotater immédiatement (Roll JWT Secret).
APP_SECURITY_JWT_SECRET=your-supabase-jwt-secret-here

# ─── DB (override defaults application-prod.yml) ─────────────────────
DB_URL=jdbc:postgresql://localhost:5432/oneclick_local
DB_USERNAME=oneclick_app
DB_PASSWORD=OneclickLocal2026

# ─── Redis (override defaults) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # vide en local

# ─── Sentry (Phase 11+) ──────────────────────────────────────────────
# SENTRY_DSN=https://xxx@o123.ingest.de.sentry.io/456
