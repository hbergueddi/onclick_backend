# ════════════════════════════════════════════════════════════════════════════
# OneClick — EnvironmentFile prod (systemd)  —  TEMPLATE / BROUILLON
# Destination cible : /etc/oneclick/oneclick.env  (chmod 600, owner root)
# Référencé depuis un drop-in :  /etc/systemd/system/oneclick.service.d/env.conf
#     [Service]
#     EnvironmentFile=/etc/oneclick/oneclick.env
#
# ⚠️ NE PAS APPLIQUER tel quel — en attente du document/instructions du dev senior.
#    Profil PROD = `enterprise,secure` (DÉCISION 17/06 : c'EST la version prod ;
#    on NE bascule PAS vers le profil Spring `prod`). Noms de vars ci-dessous = DÉFINITIFS.
#    Format systemd EnvironmentFile : KEY=VALEUR, 1 ligne, SANS guillemets,
#    valeur littérale jusqu'à fin de ligne ($/=/espaces OK, pas d'interprétation
#    bash — contrairement au `.env` chargé par `source`).
# ════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1) BASE DE DONNÉES (profil enterprise)  — DÉJÀ présent dans oneclick.service
#    (laissé ici pour consolidation ; sinon ne pas dupliquer)
# ─────────────────────────────────────────────────────────────────────────────
ENTERPRISE_DB_URL=jdbc:postgresql://localhost:5432/oneclick
ENTERPRISE_DB_USERNAME=postgres
ENTERPRISE_DB_PASSWORD=<DEJA_DANS_LE_SERVICE>            # = <DB_PASSWORD_PROD> (déjà posé)
ENTERPRISE_FLYWAY_USER=postgres
ENTERPRISE_FLYWAY_PASSWORD=<DEJA_DANS_LE_SERVICE>        # = <DB_PASSWORD_PROD> (déjà posé)

# ─────────────────────────────────────────────────────────────────────────────
# 2) REDIS  — mot de passe DÉJÀ présent (drop-in redis.conf). host/port = localhost:6379
#    (codés en dur dans application-enterprise.yml)
# ─────────────────────────────────────────────────────────────────────────────
SPRING_DATA_REDIS_PASSWORD=<DEJA_DANS_LE_SERVICE>

# ─────────────────────────────────────────────────────────────────────────────
# 3) SÉCURITÉ JWT (profil secure)  — ⚠️ MANQUANT → utilise le DEFAULT DEV public !
#    À DÉFINIR en prod : secret HS256 fort (≥ 32 octets). Doit correspondre au
#    secret de signature des tokens. (Valeur = fournie par le dev senior.)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=<SECRET_HS256_PROD_A_FOURNIR>

# ─────────────────────────────────────────────────────────────────────────────
# 4) PUSH FCM  — ⚠️ MANQUANT (objet de cette préparation) → push OFF actuellement
#    Sous profil enterprise/secure, dispatch-enabled défaut = false → FCM_DISPATCH_ENABLED
#    DOIT être posé à true. project-id + service-account-json obligatoires.
# ─────────────────────────────────────────────────────────────────────────────
FCM_PROJECT_ID=oneclick-129bb
FCM_DISPATCH_ENABLED=true
# JSON du service account Firebase (projet oneclick-129bb), BRUT, sur UNE ligne,
# sans guillemets autour. = le même JSON que celui mis dans la run-config IntelliJ.
FCM_SERVICE_ACCOUNT_JSON=<COLLER_LE_JSON_SERVICE_ACCOUNT_SUR_UNE_LIGNE>

# ─────────────────────────────────────────────────────────────────────────────
# 5) INTÉGRATIONS EXTERNES (optionnelles — stub si absentes)
# ─────────────────────────────────────────────────────────────────────────────
# Google Places (clé connue, committée — ⚠️ sans restriction HTTP referrer, cf audit E.1)
GOOGLE_PLACES_API_KEY=<CLE_GOOGLE_PLACES_A_FOURNIR>
# OCR.space (clé connue cf CLAUDE.md) — scan tickets Snap2Earn
OCR_SPACE_API_KEY=<CLE_OCR_SPACE_A_FOURNIR>
# Groq (IA : care-chat, assistant, elite-review, generate-plan) — valeur = secret à fournir
GROQ_API_KEY=<CLE_GROQ_A_FOURNIR>
# Resend (emails transactionnels brandés : onboarding partenaire, feedback, verdicts d'inscription)
# — secret à fournir. Sans cette clé, ResendClient = stub mode (aucun email envoyé).
# Domaine vérifié = app-oneclick.net (from: noreply@app-oneclick.net).
RESEND_API_KEY=<CLE_RESEND_A_FOURNIR>

# ─────────────────────────────────────────────────────────────────────────────
# 6) DIVERS (defaults déjà OK en général — surcharger seulement si besoin)
# ─────────────────────────────────────────────────────────────────────────────
APP_FRONTEND_BASE_URL=https://app-oneclick.net      # défaut déjà correct
APP_RATE_LIMIT_ENABLED=true                          # défaut base=false → recommandé true en prod

# ─────────────────────────────────────────────────────────────────────────────
# 7) STOCKAGE MÉDIA S3/MinIO — ⚠️ defaults pointent MinIO localhost:9000 (dev).
#    À CONFIRMER : la prod utilise-t-elle MinIO (sur le VPS) ? un bucket S3 réel ?
#    ou uploads non utilisés en prod ? (question pour le dev senior)
# ─────────────────────────────────────────────────────────────────────────────
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=
# S3_BUCKET=oneclick-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=true

# ════════════════════════════════════════════════════════════════════════════
# NOTE — le profil Spring `prod` (application-prod.yml) N'EST PAS utilisé.
# DÉCISION 17/06 : `enterprise,secure` EST la version prod. On garde donc les
# noms de vars ci-dessus (ENTERPRISE_DB_*, ENTERPRISE_FLYWAY_*, JWT_SECRET,
# SPRING_DATA_REDIS_PASSWORD, FCM_DISPATCH_ENABLED=true requis car défaut=false ici).
# NE PAS utiliser DB_* / APP_SECURITY_JWT_SECRET / REDIS_* / ES_* / SERVER_PORT :
# ces noms appartiennent au profil `prod`, hors périmètre.
# ════════════════════════════════════════════════════════════════════════════
